{
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": [".next*/", ".tmp/**", "coverage/**", "coverage-check/**", "next-env.d.ts"],
  "rules": {
    "eqeqeq": ["error", "always"],
    "no-console": "error",
    "no-debugger": "error"
  },
  "overrides": [
    {
      "files": ["src/lib/logger.ts", "**/*.test.{ts,tsx}"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
