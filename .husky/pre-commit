#!/usr/bin/env sh
# 文件路径: .husky/pre-commit v4.4.9
# 提交前检查：依赖完整时执行 lint-staged；本地依赖不全时回退到纯 Git 检查，完整门禁由 CI 保证
if [ -x node_modules/.bin/lint-staged ]; then
  node_modules/.bin/lint-staged || exit 1
else
  echo "[pre-commit] lint-staged 未安装，执行基础检查；完整门禁由 CI 保证"
  git diff --cached --check || exit 1
fi
